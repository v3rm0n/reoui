REOUI_ARCHIVE=/path/to/recordings
REOUI_IMAGE=reoui:local
REOUI_DATA_DIR=./.local/data
REOUI_CACHE_DIR=./.local/cache
REOUI_CAMERAS_FILE=./.secrets/cameras.json
REOUI_UID=1000
REOUI_GID=1000
REOUI_BIND=127.0.0.1
REOUI_PORT=8090
REOUI_TIMEZONE=Europe/Tallinn
REOUI_CACHE_BYTES=200000000000
# Set a long random access token before exposing the UI beyond localhost.
REOUI_AUTH_TOKEN=
# Browser-facing origin behind a reverse proxy, e.g. https://reoui.example.com.
REOUI_PUBLIC_ORIGIN=
# Exact proxy peer IPs trusted for HTTPS forwarding headers (comma-separated).
REOUI_TRUSTED_PROXIES=127.0.0.1
